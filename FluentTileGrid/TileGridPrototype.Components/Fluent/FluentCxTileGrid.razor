@namespace FluentCx.Components
@inherits FluentComponentBase


<CascadingValue Value="this" IsFixed>
    @ChildContent
    <FluentDragContainer Style="height: 100%; overflow-y: auto; overflow-x: hidden;"
                         OnDropEnd=@OnDropEnd 
                         TItem="FluentCxTileGridItem">
        <div spacing="@Spacing"
             @attributes=AdditionalAttributes
             class="fluent-tile-grid @Class"
             dir="@GlobalState.Dir.ToAttributeValue()"
             style="@GetStyle()"
             role="list">
            @foreach (var item in _children)
            {
                @item.ItemRendered
            }
        </div>
    </FluentDragContainer>
</CascadingValue>